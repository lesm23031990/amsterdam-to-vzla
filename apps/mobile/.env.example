# URL del backend Express (puerto 3001).
#
# Emulador / simulador:
#   EXPO_PUBLIC_API_URL=http://localhost:3001
#
# Dispositivo físico (recomendado para la validación de spec-20):
#   usa la IP LAN de tu PC en la misma red Wi-Fi, p. ej. http://192.168.1.10:3001
#   - generarla automáticamente:  npm run mobile:env
#   - verificarla:                npm run mobile:check
#
# El cliente de Socket.io (tracking en vivo) se deriva de este mismo origen
# (`http://IP:3001`), no hace falta otra variable.
#
# Builds en la nube (EAS): este archivo NO se sube al builder. Para builds de
# EAS define la variable en el entorno del perfil:
#   npx eas-cli env:create --environment preview \
#     --name EXPO_PUBLIC_API_URL --value http://192.168.1.10:3001 --visibility plaintext
EXPO_PUBLIC_API_URL=http://localhost:3001

