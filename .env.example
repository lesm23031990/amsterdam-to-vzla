# =============================================================================
# amsterdamToVzla & asociados — Variables de entorno
# Copia este archivo a .env y completa los valores.
# Cada sección indica en qué servicio se usa.
# =============================================================================

# --- API (server/) — Render ---
PORT=3001
JWT_SECRET=change-me-in-production
NODE_ENV=development
# En producción: lista separada por comas de orígenes permitidos.
# Ejemplo Render: https://amsterdam-to-vzla.vercel.app,https://amsterdam-to-vzla-git-main-usuario.vercel.app
# Usar "*" solo en desarrollo.
CORS_ORIGIN=*

# --- Base de datos (server/) — Neon ---
# Copiar de Neon Console: Connection string → "Pooled connection".
# Debe incluir ?sslmode=require para Neon.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Web (apps/web/) — Vercel ---
# URL pública de la API. En Vercel se setea como Environment Variable.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- IA asistente (server/ — opcional) ---
# Al menos una de las dos; sin esto la ruta /api/v1/assistant devuelve un mensaje de fallback.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Binance Pay (server/ — opcional, cuando se integre) ---
# BINANCE_PAY_API_KEY=
# BINANCE_PAY_SECRET_KEY=

# --- Exchange rates (server/ — multi-currency) ---
# Tasas por defecto si no hay en DB (COP base)
DEFAULT_RATE_BS=36.50
DEFAULT_RATE_USD=0.024

# --- Instapago (server/ — opcional, para automatizar Pago Móvil) ---
# INSTAPAGO_PUBLIC_KEY=
# INSTAPAGO_PRIVATE_KEY=

# --- Plane.so (scripts/) — sync de specs ---
PLANE_API_KEY=your_api_key_here
PLANE_WORKSPACE=lorenadevstudio
PLANE_PROJECT=c3dfc919-39e9-4ee9-b792-1da3eca8f77b